rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }
    function validProfile() {
      let data = request.resource.data;
      return data.keys().hasAll(['name', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'email', 'createdAt', 'updatedAt', 'lastAccessAt'])
        && data.name is string && data.name.size() <= 100
        && data.email is string && data.email == request.auth.token.email
        && data.createdAt is timestamp && data.updatedAt == request.time
        && (!('lastAccessAt' in data) || data.lastAccessAt is timestamp);
    }
    match /admins/{uid} {
      allow get: if isOwner(uid);
      allow list, create, update, delete: if false;
    }
    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin() && request.query.limit <= 100;
      allow create: if isOwner(uid) && validProfile()
        && request.resource.data.createdAt == request.time
        && (!('lastAccessAt' in request.resource.data)
          || request.resource.data.lastAccessAt == request.time);
      allow update: if isOwner(uid) && validProfile()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'email', 'updatedAt', 'lastAccessAt'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastAccessAt'])
          || request.resource.data.lastAccessAt == request.time);
    }
    match /users/{uid}/likes/{songId} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if (isOwner(uid) || isAdmin()) && request.query.limit <= 100;
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasAll(['title', 'artist', 'genre', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['title', 'artist', 'genre', 'updatedAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.artist is string
        && request.resource.data.artist.size() > 0
        && request.resource.data.artist.size() <= 100
        && request.resource.data.genre is string
        && request.resource.data.genre.size() > 0
        && request.resource.data.genre.size() <= 100
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(uid);
    }
    match /users/{uid}/listens/{eventId} {
      function validListen() {
        let data = request.resource.data;
        return data.keys().hasAll(['songId', 'title', 'artist', 'genre', 'qualifiedSeconds', 'listenedAt', 'syncedAt'])
          && data.keys().hasOnly(['songId', 'title', 'artist', 'genre', 'qualifiedSeconds', 'listenedAt', 'syncedAt'])
          && data.songId is string && data.songId.size() > 0 && data.songId.size() <= 200
          && data.title is string && data.title.size() > 0 && data.title.size() <= 100
          && data.artist is string && data.artist.size() > 0 && data.artist.size() <= 100
          && data.genre is string && data.genre.size() > 0 && data.genre.size() <= 100
          && data.qualifiedSeconds is int && data.qualifiedSeconds == 10
          && data.listenedAt is timestamp
          && data.syncedAt == request.time;
      }
      allow get: if isOwner(uid) || isAdmin();
      allow list: if (isOwner(uid) || isAdmin()) && request.query.limit <= 100;
      allow create: if isOwner(uid) && validListen();
      // Reintentar el mismo evento solo actualiza su confirmación de envío.
      allow update: if isOwner(uid) && validListen()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['syncedAt']);
      allow delete: if false;
    }
    // El audio se publica aparte; aquí solo se leen sus metadatos.
    // La publicación se administra desde Firebase Console.
    match /shared_songs/{songId} {
      allow get: if request.auth != null && songId == 'demo_01';
      allow list, create, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
